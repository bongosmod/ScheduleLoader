<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
    <ML>$(GameDir)\MelonLoader</ML>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ML)\net6\MelonLoader.dll;$(ML)\net6\0Harmony.dll;$(ML)\net6\Il2CppInterop.Runtime.dll;$(ML)\net6\Il2CppInterop.Common.dll;$(ML)\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>
</Project>
